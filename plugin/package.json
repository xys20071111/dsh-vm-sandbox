{
  "name": "@local/dsh-krun-vm",
  "description": "libkrun microVM sandbox backend for the DeepSeek Harness sandbox seam: confined bash/pwsh commands run inside a lightweight VM with the workspace bind-mounted read-write",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./terminal-backend": "./terminal-backend.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "terminal-backend.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "bin/krun-backend",
    "guest/dsh-vm-agent-x86_64",
    "guest/setup.sh"
  ],
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
